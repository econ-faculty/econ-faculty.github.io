ings lead to less cooperative looks.","a":["Patricia Chen","Christopher G. Myers","Shirli Kopelman","Stephen M. Garcia"],"y":2012,"c":"pub","j":"Journal of Applied Psychology","v":"97","i":"2","p":"479-486","r":93,"l":"https://doi.org/10.1037/a0026308","lt":"pub","doi":"10.1037/a0026308"}]