","Lin Zhou"],"y":2001,"c":"pub","j":"Games and Economic Behavior","v":"37","i":"2","p":"415-424","r":17,"l":"https://doi.org/10.1006/game.2001.0845","lt":"pub","doi":"10.1006/game.2001.0845"},{"t":"The Choquet Bargaining Solutions","a":["Efe A Ok","Lin Zhou"],"y":2000,"c":"pub","j":"Games and Economic Behavior","v":"33","i":"2","p":"249-264","r":17,"l":"https://doi.org/10.1006/game.1999.0778","lt":"pub","doi":"10.1006/game.1999.0778"}]