ari","Mattia Nardotto"],"y":2017,"c":"pub","j":"Management Science","v":"63","i":"9","p":"2915-2932","r":109,"l":"https://doi.org/10.1287/mnsc.2016.2499","lt":"pub","doi":"10.1287/mnsc.2016.2499"},{"t":"UNBUNDLING THE INCUMBENT: EVIDENCE FROM UK BROADBAND","a":["Mattia Nardotto","Tommaso Valletti","Frank Verboven"],"y":2015,"c":"pub","j":"Journal of the European Economic Association","v":"13","i":"2","p":"330-362","r":11,"l":"https://doi.org/10.1111/jeea.12127","lt":"pub","doi":"10.1111/jeea.12127"}]