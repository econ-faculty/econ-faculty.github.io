co.2006.11.001","lt":"pub","doi":"10.1016/j.jinteco.2006.11.001"},{"t":"The role of foreign currency debt in financial crises: 1880–1913 versus 1972–1997","a":["Michael D. Bordo","Christopher M. Meissner"],"y":2006,"c":"pub","j":"Journal of Banking and Finance","v":"30","i":"12","p":"3299-3329","r":77,"l":"https://doi.org/10.1016/j.jbankfin.2006.05.013","lt":"pub","doi":"10.1016/j.jbankfin.2006.05.013"},{"t":"Voting rules and the success of connected lending in 19th century New England banks","a":["Christopher M. Meissner"],"y":2005,"c":"pub","j":"Explorations in Economic History","v":"42","i":"4","p":"509-528","r":43,"l":"https://doi.org/10.1016/j.eeh.2004.12.001","lt":"pub","doi":"10.1016/j.eeh.2004.12.001"},{"t":"A new world order: explaining the international diffusion of the gold standard, 1870–1913","a":["Christopher M. Meissner"],"y":2005,"c":"pub","j":"Journal of International Economics","v":"66","i":"2","p":"385-406","r":22,"l":"https://doi.org/10.1016/j.jinteco.2004.08.007","lt":"pub","doi":"10.1016/j.jinteco.2004.08.007"},{"t":"Exchange-Rate Regimes and International Trade: Evidence from the Classical Gold Standard Era","a":["J. Ernesto LóPez-Córdova","Christopher M Meissner"],"y":2003,"c":"pub","j":"American Economic Review","v":"93","i":"1","p":"344-353","r":0,"l":"https://doi.org/10.1257/000282803321455331","lt":"pub","doi":"10.1257/000282803321455331"},{"t":"Austerity and the Rise of the Nazis","a":["Christopher Meissner","Gregori Galofre-Vila","Martin McKee","David Stuckler"],"c":"pub","j":"Journal of Economic History","r":42},{"t":"Growing Up to Stability? Financial Globalization, Financial Development and Financial Crises","a":["Christopher Meissner","Michael Bordo"],"y":2017,"c":"wp"},{"t":"The French Touch: Product Quality and France's Great Trade Liberalization, 1850-1874","a":["Christopher Meissner","Stephane Becuwe","Bertrand Blancheton"],"c":"wp"},{"t":"Did Tariffs Make American Manufacturing Great? New Evidence from the Gilded Age","a":["Chr